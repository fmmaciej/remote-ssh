% remote-ssh, tools

# Check remote-ssh installation health
remote-ssh doctor

# Show pinned tools vs local bin and PATH
remote-ssh check --strict

# Enable bundled Git defaults and SSH alias includes
remote-ssh git setup

# Show Git identity, SSH agent, and Git SSH auth
remote-ssh git status <ssh-host>

# Show concise CLI usage
remote-ssh --help

# Show the dynamic shell configuration guide
remote-ssh guide

# Install all supported default remote-ssh tools
remote-ssh install --full --yes

# Install selected remote-ssh tools and save expected-tools config
remote-ssh install <tools>

# Show default, expected, installed, and unsupported tools
remote-ssh tool list

# Install selected remote-ssh tool
remote-ssh tool install <tool>

$ tool: printf '%s\n' fd rg sd dust fzf bat bottom procs yazi nvim zellij nu starship eza zoxide atuin navi tspin vector
$ tools: printf '%s\n' "fd rg fzf zoxide" "fd rg fzf zoxide starship"

# Remove old inactive tool release directories after reviewing dry-run
remote-ssh prune --apply
