# GitHub account-specific SSH aliases.
#
# 1. Replace github.com-myuser with a short account alias.
# 2. Replace IdentityFile with the private key added to your GitHub account.
# 3. Point repository remotes at the alias, for example:
#      git remote set-url origin git@github.com-myuser:OWNER/REPO.git

Host github.com-myuser
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_myuser
  IdentitiesOnly yes
