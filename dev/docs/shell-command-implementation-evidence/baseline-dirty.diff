+        alias.symlink_to(c.bin, target_is_directory=True)
+        c.env["PATH"] = f"{alias}:{c.env['PATH']}"
+    elif path_present:
+        c.env["PATH"] = f"{c.bin}:{c.env['PATH']}"
+    else:
