% github, actions, ci-run

# Show app-specific jobs in a GitHub Actions run
ci-run status <run_id> <app>

# Show app-specific jobs from another repository
ci-run status <run_id> <app> --repo <repo>

# Show a specific workflow run attempt
ci-run status <run_id> <app> --attempt <attempt>

# Include log commands for successful jobs too
ci-run status <run_id> <app> --all

$ app: printf '%s\n' app api web worker
$ repo: printf '%s\n' owner/repo
$ attempt: printf '%s\n' 1 2 3
