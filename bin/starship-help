#!/usr/bin/env bash

set -euo pipefail

repo_dir="${REMOTE_ENV_DIR:-$HOME/.local/share/remote-ssh}"
starship_config="${STARSHIP_CONFIG:-${REMOTE_DOTS_DIR:-$repo_dir/dots}/starship.toml}"

cat <<EOF
remote-ssh Starship prompt

Git segment
  git::<branch>          Current branch
  [!]                    Merge conflict
  [+]                    Staged changes
  [~]                    Modified tracked files
  [>]                    Renamed files
  [-]                    Deleted files
  [?]                    Untracked files
  [\$]                    Stashed changes
  [+N]                   Local branch is N commits ahead
  [-N]                   Local branch is N commits behind
  [<>A/B]                Local branch has A ahead and B behind commits

Other segments
  time                   Current time
  user@hostname          Current user and host
  directory              Full current directory path
  [virtualenv]           Active Python virtual environment
  >                      Last command succeeded
  !                      Last command failed

Config
  $starship_config

Built-in explanation
  starship explain
EOF
