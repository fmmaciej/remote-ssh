diff --git a/tools/lib/install/dirs.sh b/tools/lib/install/dirs.sh
index b9470b0..7229c7d 100644
--- a/tools/lib/install/dirs.sh
+++ b/tools/lib/install/dirs.sh
@@ -13,7 +13,22 @@ install_shell_dir() {
 install_bin_dir() {
   log_info "  bin/..."
 
-  [[ -d $BIN_DIR ]] && find "$BIN_DIR" -maxdepth 1 -type f -exec chmod +x {} +
+  local command_path="$INSTALL_BIN_DIR/remote-ssh"
+  local command_source
+  command_source="$(cd -- "$BIN_DIR" && pwd)/remote-ssh" || return 1
+
+  if [[ -e "$command_path" || -L "$command_path" ]]; then
+    if [[ ! -L "$command_path" ]] || [[ "$(readlink "$command_path")" != "$command_source" ]]; then
+      printf 'Cannot install remote-ssh: refusing to replace %s\n' "$command_path" >&2
+      return 1
+    fi
+  fi
+
+  find "$BIN_DIR" -maxdepth 1 -type f -exec chmod +x {} + || return 1
+  mkdir -p "$INSTALL_BIN_DIR" || return 1
+  if [[ ! -L "$command_path" ]]; then
+    ln -s "$command_source" "$command_path"
+  fi
 }
 
 install_dots_dir() {
