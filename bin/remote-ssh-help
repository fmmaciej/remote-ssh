#!/usr/bin/env bash

set -euo pipefail

section="${1:-all}"

repo_dir="${REMOTE_ENV_DIR:-$HOME/.local/share/remote-ssh}"
dots_dir="${REMOTE_DOTS_DIR:-$repo_dir/dots}"
shell_dir="${REMOTE_SHELL_DIR:-$repo_dir/shell}"
atuin_marker="${XDG_STATE_HOME:-$HOME/.local/state}/remote-ssh/atuin-import-auto.done"

print_all() {
  cat <<EOF
remote-ssh help

Commands
  remote-ssh-help        Show this help
  remote-ssh-git-setup   Add remote-ssh Git config via include.path
  remote-ssh-git-identity
                         Check Git identity, SSH agent, and Git SSH auth
  starship-help          Explain remote-ssh prompt and Git status symbols
  sshf                   Pick an SSH host with fzf and connect

Aliases
  rcrc                   Reload remote-ssh shell config
  rhelp                  Show remote-ssh help
  rssh                   Cd into the installed remote-ssh repo

Functions
  remote_atuin_debug     Print current Atuin integration state

Paths
  repo                   $repo_dir
  dots                   $dots_dir
  shell                  $shell_dir
  atuin marker           $atuin_marker

Notes
  vim/nvim and tmux are not installed by remote-ssh.
  Install them manually on hosts where you want to use them.

Git SSH flow
  Git config is opt-in. Run:
    remote-ssh-git-setup
  to add dots/git/config.base via git include.path and include
  dots/ssh/config.local from ~/.ssh/config for Git SSH aliases.
  Then edit:
    $dots_dir/git/user.local
    $dots_dir/ssh/config.local
  In remote-ssh shells, git/user.local is applied as a session identity
  override without writing to repository .git/config files.
  Then point a repository remote at the alias:
    git remote set-url origin git@github.com-myuser:OWNER/REPO.git
  Test which account SSH will use:
    ssh -T git@github.com-myuser
  Or run the full identity check:
    remote-ssh-git-identity github.com-myuser
  Disable the session identity override before rc.sh loads:
    export REMOTE_SSH_ENABLE_GIT_SESSION_IDENTITY=0

Atuin
  To re-run Atuin auto import, remove:
    $atuin_marker
  and reload the shell, or run:
    atuin import auto
EOF
}

print_commands() {
  cat <<'EOF'
Commands
  remote-ssh-help        Show this help
  remote-ssh-git-setup   Add remote-ssh Git config via include.path
  remote-ssh-git-identity
                         Check Git identity, SSH agent, and Git SSH auth
  starship-help          Explain remote-ssh prompt and Git status symbols
  sshf                   Pick an SSH host with fzf and connect
EOF
}

print_aliases() {
  cat <<'EOF'
Aliases
  rcrc                   Reload remote-ssh shell config
  rhelp                  Show remote-ssh help
  rssh                   Cd into the installed remote-ssh repo
EOF
}

print_functions() {
  cat <<'EOF'
Functions
  remote_atuin_debug     Print current Atuin integration state
EOF
}

print_paths() {
  cat <<EOF
Paths
  repo                   $repo_dir
  dots                   $dots_dir
  shell                  $shell_dir
  atuin marker           $atuin_marker
EOF
}

print_git() {
  cat <<EOF
Git SSH flow
  Run setup:
    remote-ssh-git-setup
  Edit your remote-ssh Git identity:
    $dots_dir/git/user.local
  Edit your account-specific SSH alias:
    $dots_dir/ssh/config.local
  The Git identity file is applied as a session override in remote-ssh shells,
  so it can override repository .git/config without writing to it.
  Use that alias in repository remotes:
    git remote set-url origin git@github.com-myuser:OWNER/REPO.git
  Verify the Git account used by SSH:
    ssh -T git@github.com-myuser
  Check Git config, SSH agent, and SSH auth together:
    remote-ssh-git-identity github.com-myuser
  Disable the session identity override before rc.sh loads:
    export REMOTE_SSH_ENABLE_GIT_SESSION_IDENTITY=0
EOF
}

usage() {
  cat <<'EOF' >&2
Usage: remote-ssh-help [all|commands|aliases|functions|paths|git]
EOF
  exit 1
}

case "$section" in
  all) print_all ;;
  commands) print_commands ;;
  aliases) print_aliases ;;
  functions) print_functions ;;
  paths) print_paths ;;
  git) print_git ;;
  *) usage ;;
esac
