# GitHub account-specific SSH aliases.
#
# 1. Replace github.com-myuser with a short account alias.
# 2. If you use agent forwarding, keep IdentitiesOnly no and omit IdentityFile.
# 3. If you keep the key on this machine, set IdentityFile and use IdentitiesOnly yes.
# 4. Point repository remotes at the alias, for example:
#      git remote set-url origin git@github.com-myuser:OWNER/REPO.git

Host github.com-myuser
  HostName github.com
  User git
  IdentitiesOnly no

# Local-key variant:
#
# Host github.com-myuser-local
#   HostName github.com
#   User git
#   IdentityFile ~/.ssh/id_ed25519_myuser
#   IdentitiesOnly yes
